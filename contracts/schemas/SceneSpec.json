{
  "$defs": {
    "BasePose": {
      "properties": {
        "position": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "yaw": {
          "default": 0.0,
          "title": "Yaw",
          "type": "number"
        }
      },
      "title": "BasePose",
      "type": "object"
    },
    "Marker": {
      "description": "A named point in the world frame: pick-up and drop-off points, waypoints, docking stations.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,40}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "title": "Name",
          "type": "string"
        },
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "note": {
          "default": "",
          "maxLength": 400,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "position"
      ],
      "title": "Marker",
      "type": "object"
    },
    "ObjectModel": {
      "description": "A recognisable model of a task object made of simple primitives (objects agent).",
      "properties": {
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/ObjectModelPart"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Parts",
          "type": "array"
        },
        "note": {
          "default": "",
          "maxLength": 300,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "parts"
      ],
      "title": "ObjectModel",
      "type": "object"
    },
    "ObjectModelPart": {
      "description": "One primitive of an object model, in the object's own frame: origin at the centre of the object's box, z up.",
      "properties": {
        "shape": {
          "enum": [
            "box",
            "cylinder",
            "sphere",
            "cone",
            "capsule",
            "torus"
          ],
          "title": "Shape",
          "type": "string"
        },
        "center": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center",
          "type": "array"
        },
        "size": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Size",
          "type": "array"
        },
        "rotation": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Rotation",
          "type": "array"
        },
        "color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "roughness": {
          "default": 0.6,
          "maximum": 1,
          "minimum": 0,
          "title": "Roughness",
          "type": "number"
        },
        "metalness": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Metalness",
          "type": "number"
        },
        "opacity": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0.1,
          "title": "Opacity",
          "type": "number"
        },
        "label": {
          "default": "",
          "maxLength": 60,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "shape",
        "center",
        "size",
        "color"
      ],
      "title": "ObjectModelPart",
      "type": "object"
    },
    "SceneBox": {
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,40}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "obstacle",
          "enum": [
            "table",
            "shelf",
            "wall",
            "obstacle",
            "conveyor",
            "pallet",
            "box",
            "floor_zone"
          ],
          "title": "Kind",
          "type": "string"
        },
        "center": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center",
          "type": "array"
        },
        "size": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Size",
          "type": "array"
        },
        "yaw": {
          "default": 0.0,
          "title": "Yaw",
          "type": "number"
        },
        "color": {
          "default": "#9aa5b1",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "collides": {
          "default": true,
          "title": "Collides",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "center",
        "size"
      ],
      "title": "SceneBox",
      "type": "object"
    },
    "SceneObject": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "shape": {
          "default": "box",
          "enum": [
            "box",
            "cylinder",
            "sphere"
          ],
          "title": "Shape",
          "type": "string"
        },
        "center": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center",
          "type": "array"
        },
        "size": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Size",
          "type": "array"
        },
        "color": {
          "default": "#2f80ed",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string",
          "x-optional": true
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "x-optional": true
        }
      },
      "required": [
        "id",
        "center",
        "size"
      ],
      "title": "SceneObject",
      "type": "object"
    }
  },
  "properties": {
    "floor_size_m": {
      "default": [
        4.0,
        4.0
      ],
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
