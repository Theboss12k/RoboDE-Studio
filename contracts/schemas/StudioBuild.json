          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "ShopPrice": {
      "description": "A price as a shop listed it on a date: an estimate for planning, never a quote.",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "currency": {
          "default": "INR",
          "maxLength": 8,
          "title": "Currency",
          "type": "string"
        },
        "seen": {
          "maxLength": 40,
          "title": "Seen",
          "type": "string"
        },
        "shop": {
          "maxLength": 80,
          "title": "Shop",
          "type": "string"
        },
        "source_url": {
          "maxLength": 800,
          "title": "Source Url",
          "type": "string"
        },
        "quote": {
          "default": "",
          "maxLength": 600,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "seen",
        "shop",
        "source_url"
      ],
      "title": "ShopPrice",
      "type": "object"
    },
    "SpecValue": {
      "description": "One value of a motor or part. verified = quoted on the shop/datasheet page and the quote contains the number\n(checked in code); assumed = from a standard table or rule (e.g. NEMA frame size); defined = a value we specify\nfor procurement because nothing suitable was found.",
      "properties": {
        "key": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "text": {
          "default": "",
          "maxLength": 120,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "default": "",
          "maxLength": 40,
          "title": "Unit",
          "type": "string"
        },
        "status": {
          "enum": [
            "verified",
            "assumed",
            "defined"
          ],
          "title": "Status",
          "type": "string"
        },
        "quote": {
          "default": "",
          "maxLength": 600,
          "title": "Quote",
          "type": "string"
        },
        "source_url": {
          "default": "",
          "maxLength": 800,
          "title": "Source Url",
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 300,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "key",
        "status"
      ],
      "title": "SpecValue",
      "type": "object"
    },
    "StructureStyle": {
      "properties": {
        "style": {
          "enum": [
