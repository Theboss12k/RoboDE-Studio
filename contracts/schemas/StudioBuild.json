{
  "$defs": {
    "BuildFile": {
      "properties": {
        "path": {
          "maxLength": 300,
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "enum": [
            "step",
            "stl",
            "urdf",
            "pdf",
            "zip",
            "csv",
            "png",
            "json"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "default": "",
          "maxLength": 64,
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "default": 0,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "title": "BuildFile",
      "type": "object"
    },
    "BuildPart": {
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "title": "Name",
          "type": "string"
        },
        "qty": {
          "default": 1,
          "minimum": 1,
          "title": "Qty",
          "type": "integer"
        },
        "material": {
          "default": "",
          "maxLength": 120,
          "title": "Material",
          "type": "string"
        },
        "process": {
          "enum": [
            "printed",
            "machined",
            "cut",
            "purchased",
            "standard"
          ],
          "title": "Process",
          "type": "string"
        },
        "source": {
          "enum": [
            "custom",
            "standard",
            "purchased"
          ],
          "title": "Source",
          "type": "string"
        },
        "mass_kg": {
          "default": 0.0,
          "title": "Mass Kg",
          "type": "number"
        },
        "link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Link"
        },
        "joint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Joint"
        },
        "files": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BuildFile"
          },
          "title": "Files",
          "type": "array"
        },
        "spec": {
          "default": "",
          "maxLength": 400,
          "title": "Spec",
          "type": "string"
        },
        "url": {
          "default": "",
          "maxLength": 800,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "process",
        "source"
      ],
      "title": "BuildPart",
      "type": "object"
    },
    "Calc": {
      "description": "A traceable calculation: what was computed, how, from what.",
      "properties": {
        "formula": {
          "title": "Formula",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Quantity"
          },
          "title": "Inputs",
          "type": "object"
        },
        "result": {
          "title": "Result",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "formula",
        "inputs",
        "result",
        "unit"
      ],
      "title": "Calc",
      "type": "object"
    },
    "Check": {
      "properties": {
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "required": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Required"
        },
        "actual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actual"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Passed"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "calc": {
          "anyOf": [
            {
              "$ref": "#/$defs/Calc"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "requirement_id",
        "name",
        "required",
        "actual",
        "unit",
        "passed"
      ],
      "title": "Check",
      "type": "object"
    },
    "Drive": {
      "description": "The transmission between motor and joint. ratio = motor turns per joint turn; for a leadscrew or belt-driven\nlinear axis, ratio = motor rad per metre of travel (2*pi/lead or 2*pi/(pulley pitch circumference)).",
      "properties": {
        "type": {
          "enum": [
            "direct",
            "planetary",
            "harmonic",
            "belt",
            "leadscrew",
            "rack",
            "wheel_gearbox"
          ],
          "title": "Type",
          "type": "string"
        },
        "ratio": {
          "exclusiveMinimum": 0,
          "title": "Ratio",
          "type": "number"
        },
        "efficiency": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Efficiency",
          "type": "number"
        },
        "lead_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lead M"
        },
        "name": {
          "default": "",
          "maxLength": 200,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "type",
        "ratio",
        "efficiency"
      ],
      "title": "Drive",
      "type": "object"
    },
    "ElectronicsItem": {
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "driver",
            "controller",
            "power_supply",
            "battery",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "title": "Name",
          "type": "string"
        },
        "source": {
          "enum": [
            "shop",
            "defined"
          ],
          "title": "Source",
          "type": "string"
        },
        "qty": {
          "default": 1,
          "minimum": 1,
          "title": "Qty",
          "type": "integer"
        },
        "for_joints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "For Joints",
          "type": "array"
        },
        "shop": {
          "default": "",
          "maxLength": 80,
          "title": "Shop",
          "type": "string"
        },
        "url": {
          "default": "",
          "maxLength": 800,
          "title": "Url",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShopPrice"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "values": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SpecValue"
          },
          "title": "Values",
          "type": "array"
        },
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Check"
          },
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "role",
        "name",
        "source"
      ],
      "title": "ElectronicsItem",
      "type": "object"
    },
    "JointSizing": {
      "description": "What a joint needs, computed in code from the design (gravity_torques over the task frames and a stretched pose,\nlink inertia times acceleration, RMS over the frames, safety factors).",
      "properties": {
        "joint": {
          "title": "Joint",
          "type": "string"
        },
        "kind": {
          "enum": [
            "revolute",
            "prismatic",
            "wheel"
          ],
          "title": "Kind",
          "type": "string"
        },
        "static_torque": {
          "title": "Static Torque",
          "type": "number"
        },
        "accel_torque": {
          "title": "Accel Torque",
          "type": "number"
        },
        "continuous": {
          "title": "Continuous",
          "type": "number"
        },
        "peak": {
          "title": "Peak",
          "type": "number"
        },
        "speed": {
          "title": "Speed",
          "type": "number"
        },
        "torque_unit": {
          "default": "N*m",
          "title": "Torque Unit",
          "type": "string"
        },
        "speed_unit": {
          "default": "rad/s",
          "title": "Speed Unit",
          "type": "string"
        },
        "calcs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Calc"
          },
          "title": "Calcs",
          "type": "array"
        }
      },
      "required": [
        "joint",
        "kind",
        "static_torque",
        "accel_torque",
        "continuous",
        "peak",
        "speed"
      ],
      "title": "JointSizing",
      "type": "object"
    },
    "MotorAlternative": {
