        },
        "name": {
          "maxLength": 200,
          "title": "Name",
          "type": "string"
        },
        "shop": {
          "default": "",
          "maxLength": 80,
          "title": "Shop",
          "type": "string"
        },
        "url": {
          "default": "",
          "maxLength": 800,
          "title": "Url",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShopPrice"
