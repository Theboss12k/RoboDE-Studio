          "title": "Motor Type",
          "type": "string"
        },
        "values": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SpecValue"
          },
          "title": "Values",
          "type": "array"
        },
        "drive": {
          "anyOf": [
            {
              "$ref": "#/$defs/Drive"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "passes": {
          "default": false,
          "title": "Passes",
          "type": "boolean"
        },
        "reason": {
          "default": "",
          "maxLength": 400,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "MotorAlternative",
      "type": "object"
    },
