{
  "$defs": {
    "Calc": {
      "description": "A traceable calculation: what was computed, how, from what.",
      "properties": {
        "formula": {
          "title": "Formula",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Quantity"
          },
          "title": "Inputs",
          "type": "object"
        },
        "result": {
          "title": "Result",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "formula",
        "inputs",
        "result",
        "unit"
      ],
      "title": "Calc",
      "type": "object"
    },
    "Check": {
      "properties": {
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "required": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Required"
        },
        "actual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actual"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Passed"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "calc": {
          "anyOf": [
            {
              "$ref": "#/$defs/Calc"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "default": "sim",
          "enum": [
            "sim",
            "planned"
          ],
          "title": "Source",
          "type": "string",
          "x-optional": true
        }
      },
      "required": [
        "requirement_id",
        "name",
        "required",
        "actual",
        "unit",
        "passed"
      ],
      "title": "Check",
      "type": "object"
    },
    "Frame": {
      "properties": {
        "t": {
          "title": "T",
          "type": "number"
        },
        "joints": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Joints",
          "type": "object"
        },
        "base": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base"
        },
        "holding": {
          "default": "",
          "title": "Holding",
          "type": "string"
        },
        "tcp": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tcp"
        },
        "phase": {
          "default": "",
          "title": "Phase",
          "type": "string"
        }
      },
      "required": [
        "t",
        "joints"
      ],
      "title": "Frame",
      "type": "object"
    },
    "Quantity": {
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "SimEvent": {
      "properties": {
        "t": {
          "title": "T",
          "type": "number"
        },
        "kind": {
          "enum": [
            "info",
            "warning",
            "collision",
            "unreachable",
            "limit"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "t",
        "kind",
        "text"
      ],
      "title": "SimEvent",
      "type": "object"
    }
  },
  "properties": {
    "frames": {
      "items": {
        "$ref": "#/$defs/Frame"
      },
      "title": "Frames",
      "type": "array"
    },
    "events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SimEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "checks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Check"
      },
      "title": "Checks",
      "type": "array"
    },
    "duration_s": {
      "default": 0.0,
      "title": "Duration S",
      "type": "number"
    },
    "ok": {
      "default": false,
      "title": "Ok",
      "type": "boolean"
    }
  },
  "required": [
    "frames"
  ],
  "title": "SimResult",
  "type": "object"
}
