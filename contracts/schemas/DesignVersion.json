        },
        "result": {
          "title": "Result",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "formula",
        "inputs",
        "result",
        "unit"
      ],
      "title": "Calc",
      "type": "object"
    },
    "Check": {
      "properties": {
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
