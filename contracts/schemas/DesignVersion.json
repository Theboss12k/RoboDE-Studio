          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "position"
      ],
      "title": "Marker",
      "type": "object"
    },
    "PhysicsInputs": {
      "description": "The numeric part of the payload and motion description. The physics engine reads only this.",
      "properties": {
        "object_mass_kg": {
          "exclusiveMinimum": 0,
          "maximum": 5000,
          "title": "Object Mass Kg",
          "type": "number"
        },
        "object_size_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Object Size M",
          "type": "array"
        },
        "tool_mass_kg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Mass Kg"
        },
        "grip": {
          "default": "parallel",
          "enum": [
            "parallel",
            "vacuum",
            "magnetic",
            "hook",
            "fork",
            "none"
          ],
          "title": "Grip",
          "type": "string"
        },
        "friction_coefficient": {
          "default": 0.4,
          "exclusiveMinimum": 0,
          "maximum": 2,
          "title": "Friction Coefficient",
          "type": "number"
        },
        "contact_count": {
          "default": 2,
          "maximum": 8,
          "minimum": 1,
          "title": "Contact Count",
          "type": "integer"
        },
        "cycle_time_s": {
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Cycle Time S",
          "type": "number"
        },
        "positional_accuracy_m": {
          "default": 0.005,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Positional Accuracy M",
          "type": "number"
        },
        "safety_factor": {
          "default": 1.5,
          "maximum": 5,
          "minimum": 1,
          "title": "Safety Factor",
          "type": "number"
        },
        "clearance_m": {
          "default": 0.05,
          "maximum": 2,
          "minimum": 0,
          "title": "Clearance M",
          "type": "number"
        },
        "approach_height_m": {
          "default": 0.1,
          "maximum": 2,
          "minimum": 0,
          "title": "Approach Height M",
          "type": "number"
        },
        "peak_acceleration_m_s2": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Acceleration M S2"
        },
        "travel_distance_m": {
          "default": 0.0,
          "minimum": 0,
          "title": "Travel Distance M",
          "type": "number"
        },
        "travel_speed_m_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Travel Speed M S"
        },
        "slope_deg": {
          "default": 0.0,
          "maximum": 45,
          "minimum": 0,
          "title": "Slope Deg",
          "type": "number"
        },
        "rolling_resistance": {
          "default": 0.015,
          "maximum": 0.5,
          "minimum": 0,
          "title": "Rolling Resistance",
          "type": "number"
        },
        "vehicle_mass_kg": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vehicle Mass Kg"
        },
        "wheel_radius_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wheel Radius M"
        },
        "shifts_per_day": {
          "default": 1.0,
          "maximum": 3,
          "minimum": 0,
          "title": "Shifts Per Day",
          "type": "number"
        },
        "cycles_per_hour": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cycles Per Hour"
        }
      },
      "required": [
        "object_mass_kg",
        "object_size_m",
        "cycle_time_s"
      ],
      "title": "PhysicsInputs",
      "type": "object"
    },
