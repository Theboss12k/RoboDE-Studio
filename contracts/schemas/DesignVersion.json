      "title": "FleetAssignment",
      "type": "object"
    },
    "FleetHandover": {
      "properties": {
        "id": {
          "pattern": "^h[1-9]$",
          "title": "Id",
          "type": "string"
        },
        "object": {
          "title": "Object",
          "type": "string"
        },
        "from_member": {
          "title": "From Member",
          "type": "string"
        },
        "to_member": {
          "title": "To Member",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "fixed": {
          "default": false,
          "title": "Fixed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "object",
        "from_member",
        "to_member"
