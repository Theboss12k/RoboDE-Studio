        "slope_deg": {
          "default": 0.0,
          "maximum": 45,
          "minimum": 0,
          "title": "Slope Deg",
          "type": "number"
        }
      },
      "title": "Locomotion",
      "type": "object"
    },
    "Marker": {
      "description": "A named point in the world frame: pick-up and drop-off points, waypoints, docking stations.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,40}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "title": "Name",
          "type": "string"
        },
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
