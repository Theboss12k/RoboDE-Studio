            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Reach M"
        },
        "max_payload_kg": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 2000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Payload Kg"
        },
        "budget_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
