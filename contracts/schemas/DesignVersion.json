      },
      "required": [
        "requirement_id",
        "name",
        "required",
        "actual",
        "unit",
        "passed"
      ],
      "title": "Check",
      "type": "object"
    },
    "FleetAssignment": {
      "properties": {
        "members": {
          "items": {
            "$ref": "#/$defs/FleetMemberAssignment"
