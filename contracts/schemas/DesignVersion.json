        },
        "brands": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Brands",
          "type": "array"
        },
        "note": {
          "default": "",
          "maxLength": 1000,
          "title": "Note",
          "type": "string"
        }
      },
      "title": "FleetLimits",
      "type": "object"
    },
    "FleetMember": {
      "properties": {
